#!/bin/sh
#
# Copy and run this in the OpenSSL directory for MIPS compatible OpenSSL stack
#
# No confirmed WSL Debian3 substitute for this exact vendor GPL SDK toolchain
# (libc unclear); Debian's apt MIPS cross toolchains are glibc, likely
# ABI-mismatched against the deployed uClibc target.
#
# asm re-enabled below (dropped -no-asm): builds clean MIPS asm objects
# (bn-mips.o, aes-mips.o, sha1-mips.o, sha256-mips.o, mips-mont.o) under a
# modern apt mipsel-linux-gnu-gcc. Not tested against the old vendor-4.3 CC
# this script actually points at - that toolchain isn't available here.
export PATH=/home/default/Public/PTV1000-GPL/mips-4.3/bin:$PATH
export CC=/home/default/Public/PTV1000-GPL/mips-4.3/bin/mips-linux-gnu-gcc

cd ../openssl
make clean
./Configure linux-mips32 no-weak-ssl-ciphers no-srp no-psk no-comp no-zlib no-zlib-dynamic no-hw no-dso no-shared no-rc5 no-idea no-md4 no-rmd160 no-ssl no-ssl3 no-seed no-camellia no-bf no-cast no-md2 no-mdc2 no-engine no-ocsp no-cms -Os -EL
make depend
make -j "$(nproc)"
mkdir -p ../linux/mipsel
cp *.a ../linux/mipsel
cd ..
