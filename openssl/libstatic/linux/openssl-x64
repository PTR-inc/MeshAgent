#!/bin/sh
#
# Copy and run this in the OpenSSL directory for Intel x86 64bit compatible OpenSSL stack
#
# Exception to every other target here: asm is left ENABLED (no -no-asm) for
# AES-NI/SHA-NI/bignum throughput on a native x86-64 build. Keep this flag
# list otherwise identical to openssl-x86 and the other openssl-<arch> scripts.
cd ../openssl
make clean
./Configure linux-x86_64 no-weak-ssl-ciphers no-srp no-psk no-comp no-zlib no-zlib-dynamic no-hw no-dso no-shared no-rc5 no-idea no-md4 no-rmd160 no-ssl no-ssl3 no-seed no-camellia no-bf no-cast no-md2 no-mdc2 no-engine no-ocsp no-cms enable-ec_nistp_64_gcc_128
make depend
make -j "$(nproc)"
mkdir -p ../linux/x86-64
cp *.a ../linux/x86-64
cd ..
