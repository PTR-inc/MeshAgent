#!/bin/sh
#
# Copy and run this in the OpenSSL directory for ARM compatible OpenSSL stack
#
# No WSL Debian3 substitute available - needs a musl-targeting ARM cross
# compiler; Debian's apt musl-gcc is host-native x86-64 only, no cross variant.
export PATH=/tmp/ToolChains/staging_dir/toolchain-arm_cortex-a15+neon-vfpv4_gcc-8.4.0_musl_eabi/bin/:$PATH
export CC=/tmp/ToolChains/staging_dir/toolchain-arm_cortex-a15+neon-vfpv4_gcc-8.4.0_musl_eabi/bin/arm-openwrt-linux-muslgnueabi-gcc

cd ../openssl
make clean
./Configure linux-generic32 no-weak-ssl-ciphers no-srp no-psk no-comp no-zlib no-zlib-dynamic no-hw no-dso no-shared -no-asm no-rc5 no-idea no-md4 no-rmd160 no-ssl no-ssl3 no-seed no-camellia no-bf no-cast no-md2 no-mdc2 no-engine no-ocsp no-cms -Os
make depend
make -j "$(nproc)"
mkdir -p ../linux/armvirt32
cp *.a ../linux/armvirt32
cd ..
