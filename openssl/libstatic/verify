#!/bin/bash
# Read-only audit of every committed OpenSSL static archive. Every libc decision comes from
# targets.sh's T_LIBC, so there is no second list here. Usage is [SFX=-<suffix>] verify [dir ...],
# where SFX narrows the run to one archive suffix and an empty SFX means the unsuffixed archives only.

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
. "$HERE/../../build-env.sh" >/dev/null || exit 1
. "$BR_SCRIPTS/targets.sh" || exit 1
cd "$HERE" || exit 1

# Directories deliberately kept but built by nothing are listed in build/orphans.txt.
ORPHANS=$(sed 's/#.*//' "$BR_SCRIPTS/orphans.txt" 2>/dev/null | tr -s '[:space:]' ' ')

# Looks up a directory's T_LIBC and T_OBJS from targets.sh's own T_DEST, so nothing is restated here.
libc_for_dir() {
	local t d
	for t in $BR_ALL_TARGETS; do
		br_target "$t" || continue
		for d in $T_DEST; do [ "$d" = "$1" ] && { echo "$T_LIBC $T_OBJS"; return 0; }; done
	done
	echo unknown
}

if [ $# -gt 0 ]; then
	files=""
	for d in "$@"; do files="$files $d/libcrypto${SFX-*}.a"; done
else
	files=$(find linux macos bsd -maxdepth 2 -name "libcrypto${SFX-*}.a" 2>/dev/null | sort)
fi

rc=0
printf '%-32s %-7s %-9s %-5s %-6s %-9s %s\n' TARGET LIBC VERSION OBJS GLIBC UCONTEXT ARCH
printf '%-32s %-7s %-9s %-5s %-6s %-9s %s\n' ------ ---- ------- ---- ----- -------- ----
for f in $files; do
	[ -f "$f" ] || { echo "  MISSING: $f" >&2; rc=1; continue; }
	d=$(dirname "$f")
	set -- $(libc_for_dir "$d"); libc=$1; want=${2:-}
	# Suffixed archives such as libcrypto-3.0.16.a get their own label so rows for the same
	# directory stay distinguishable. $d stays bare because the libc lookup needs the plain directory.
	t=$d; b=$(basename "$f" .a)
	[ "$b" = libcrypto ] || t="$d ${b#libcrypto}"
	v=$(strings "$f" | grep -oE 'OpenSSL [0-9]+\.[0-9]+\.[0-9]+[a-z-]*' | sort -u | head -1)
	n=$(ar t "$f" | wc -l)
	g=$(nm --undefined-only "$f" 2>/dev/null | awk '{print $NF}' | grep -cE "$GLIBC_ONLY_RE")
	u=$(nm --undefined-only "$f" 2>/dev/null | awk '{print $NF}' | grep -cE "$UCONTEXT_RE")
	obj=$(ar t "$f" | grep -m1 '\.o$')
	tmp=$(mktemp -d); ( cd "$tmp" && ar x "$HERE/$f" "$obj" 2>/dev/null )
	a=$(file -b "$tmp/$obj" 2>/dev/null | cut -d, -f1-3 | sed 's/ELF //;s/ relocatable//;s/, version 1 (SYSV)//')
	rm -rf "$tmp"
	printf '%-32s %-7s %-9s %-5s %-6s %-9s %s\n' "$t" "$libc" "${v#OpenSSL }" "$n" "$g" "$u" "$a"

	# The object count is the recipe's fingerprint. A mismatch means the archive was built
	# with different Configure options than targets.sh says.
	[ -n "$want" ] && [ "$n" != "$want" ] && \
		{ echo "  REJECT: $d has $n objects, targets.sh expects $want - rebuilt with a different recipe" >&2; rc=1; }
	case "$libc" in
	musl|uclibc)
		# A glibc-only symbol means the agent links but will not start on the device.
		[ "$g" -gt 0 ] && { echo "  REJECT: $d references $g glibc-only symbol(s) but its agent is $libc" >&2; rc=1; } ;;
	unknown)
		case " $ORPHANS " in
			*" $d "*) ;;   # A known orphan, documented in build/orphans.txt.
			*) echo "  REJECT: $d is the T_DEST of no target in targets.sh - add the target, or list the dir in build/orphans.txt" >&2; rc=1 ;;
		esac ;;
	esac
	# ucontext is gated only for musl, which implements it on no architecture, so the agent
	# link would fail outright. uClibc's libc.so does implement it.
	[ "$libc" = musl ] && [ "$u" -gt 0 ] && \
		{ echo "  REJECT: $d references $u ucontext symbol(s); musl implements none - agent link will fail" >&2; rc=1; }
done

echo
echo "LIBC comes from targets.sh's T_LIBC. GLIBC = refs to $GLIBC_ONLY_RE"
echo "(must be 0 for musl/uClibc). UCONTEXT = get/set/make/swapcontext (must be"
echo "0 for musl only). Nonzero on glibc/bsd/macos rows is expected and fine."
exit $rc
