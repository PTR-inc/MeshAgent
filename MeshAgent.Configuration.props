<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared by all agent projects. Imported before Microsoft.Cpp.props because the toolset reads
  these while loading. The rest of the shared settings are in MeshAgent.Common.props.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Configuration">
    <MeshDebug Condition="$(Configuration.StartsWith('Debug'))">true</MeshDebug>
    <MeshDebug Condition="'$(MeshDebug)'==''">false</MeshDebug>
    <!-- EnableASAN is the C++ toolset's own property. A separate configuration keeps the sanitized
         objects and binary out of the normal build's directories. -->
    <EnableASAN Condition="$(Configuration.EndsWith('_ASAN'))">true</EnableASAN>
    <ConfigurationType>Application</ConfigurationType>
    <!-- msbuild /p:MeshToolset=v145 picks VS 2026, /p:MeshToolset=v142 the VS 2019 toolset. -->
    <MeshDefaultToolset>v143</MeshDefaultToolset>
    <MeshToolset Condition="'$(MeshToolset)'==''">$(MeshDefaultToolset)</MeshToolset>
    <!-- Any other toolset gets its own output directory, or its objects and binary silently
         overwrite the default toolset's. MeshAgent-2019.sln builds with v142. -->
    <MeshToolsetSuffix Condition="'$(MeshToolset)'!='$(MeshDefaultToolset)'">-$(MeshToolset)</MeshToolsetSuffix>
    <PlatformToolset>$(MeshToolset)</PlatformToolset>
    <!-- An x64 host otherwise drives the 32-bit toolchain for Win32, which is slower and runs out
         of address space under link-time code generation. -->
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
    <CharacterSet>MultiByte</CharacterSet>
    <UseDebugLibraries>$(MeshDebug)</UseDebugLibraries>
    <WholeProgramOptimization Condition="'$(MeshDebug)'=='false'">true</WholeProgramOptimization>
  </PropertyGroup>
</Project>
